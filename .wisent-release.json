{
  "schema_version": 1,
  "product": "singularity",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9A-Za-z.+-]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ]
        }
      ],
      "build": {
        "argv": [
          "./release/build.sh"
        ]
      },
      "stage": {
        "singularity": "bin/singularity",
        "singularity-bootstrap": "bin/singularity-bootstrap",
        "singularity-repo-mcp": "bin/singularity-repo-mcp",
        "singularity-finance-mcp": "bin/singularity-finance-mcp",
        "singularity-finance-executor-http": "bin/singularity-finance-executor-http"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--all",
            "--",
            "--check"
          ]
        }
      ],
      "build": {
        "argv": [
          "./release/build.sh"
        ]
      },
      "stage": {
        "singularity": "bin/singularity",
        "singularity-bootstrap": "bin/singularity-bootstrap",
        "singularity-repo-mcp": "bin/singularity-repo-mcp",
        "singularity-finance-mcp": "bin/singularity-finance-mcp",
        "singularity-finance-executor-http": "bin/singularity-finance-executor-http"
      }
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/singularity/dependencies/private-cargo-sources/sha256/0efc306b22696820b2da1006f87a4baf8a8d2c9a65115bc899097f4fa7315bb3/source.tar.gz",
      "sha256": "0efc306b22696820b2da1006f87a4baf8a8d2c9a65115bc899097f4fa7315bb3",
      "mount": "private-cargo-sources",
      "extract": true
    }
  }
}
