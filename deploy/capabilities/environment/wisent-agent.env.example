# Copy to /etc/wisent/agents/<target>/agent.env and replace every marker.
# <target> is exactly one of: weles, most-service, brama, singularity-bootstrap.
# The file, manifest, and signing key must be 0600 and owned by that target's UID.
# Values are identifiers and path references only; never put grants or credentials here.
SINGULARITY_BOOTSTRAP_BINARY=/REPLACE_WITH_PINNED_RELEASE/singularity-bootstrap
SINGULARITY_BOOTSTRAP_BINARY_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
SINGULARITY_BOOTSTRAP_MANIFEST=/REPLACE_WITH_AGENT_PRIVATE_CONFIG/bootstrap-manifest.json
SINGULARITY_BOOTSTRAP_MANIFEST_SIG=/REPLACE_WITH_AGENT_PRIVATE_CONFIG/bootstrap-manifest.json.sig
SINGULARITY_BOOTSTRAP_TRUST_ROOT=/REPLACE_WITH_AGENT_PRIVATE_CONFIG/bootstrap-trust-root.pub
SINGULARITY_RUNTIME_ROOT=/run/wisent-agent-REPLACE_WITH_TARGET
SKARBIEC_CAP_SOCKET=/run/skarbiec-capability/broker.sock
SKARBIEC_WORKLOAD_ID=REPLACE_WITH_EXACT_CONTRACT_TARGET
SKARBIEC_WORKLOAD_SIGNING_KEY_FILE=/REPLACE_WITH_AGENT_PRIVATE_CONFIG/workload-signing.key
