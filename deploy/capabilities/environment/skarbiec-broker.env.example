# Schema-only path references. Preflight rejects every unresolved marker; no value is a secret.
# The SKARBIEC_* runtime entries retain the exact signed Las MCP env_names order.
SKARBIEC_BINARY=/REPLACE_WITH_PINNED_RELEASE/skarbiec-entitlements-router
SKARBIEC_BINARY_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
SKARBIEC_VAULT_FILE=/REPLACE_WITH_PRIVATE_CONFIG/vault.json
SKARBIEC_CAP_POLICY=/REPLACE_WITH_PRIVATE_CONFIG/agent-policy.json
SKARBIEC_CAP_POLICY_SIG=/REPLACE_WITH_PRIVATE_CONFIG/agent-policy.json.sig
SKARBIEC_CAP_TRUST_ROOT=/REPLACE_WITH_PRIVATE_CONFIG/policy-trust-root.pub
SKARBIEC_WORKLOAD_REGISTRY=/REPLACE_WITH_PRIVATE_CONFIG/workload-registry.json
SKARBIEC_WORKLOAD_REGISTRY_SIG=/REPLACE_WITH_PRIVATE_CONFIG/workload-registry.json.sig
SKARBIEC_CAP_STATE=/var/lib/skarbiec-capability
SKARBIEC_CAP_SOCKET=/run/skarbiec-capability/broker.sock
SKARBIEC_WORM_RECEIPT_DIR=/var/lib/skarbiec-worm-staging
SKARBIEC_WORM_CHECKPOINT=/var/lib/skarbiec-capability/worm-checkpoint.json
SKARBIEC_WORM_RECEIPT_COMMAND=/REPLACE_WITH_PINNED_RELEASE/worm-receipt-writer
SKARBIEC_MCP_AGENT_ID=REPLACE_WITH_EXPLICIT_NON_WILDCARD_AGENT_ID
SKARBIEC_CAP_SOCKET_GID=REPLACE_WITH_NUMERIC_SKARBIEC_CAPABILITY_CLIENTS_GID
